# Nombre registrado de tu app en https://api.audius.co/plans
VITE_AUDIUS_APP_NAME=hermesproyec
# Clave pública de Audius (segura en frontend). El Bearer Token NUNCA va aquí.
VITE_AUDIUS_API_KEY=
# --- Respaldo Supabase (nube) ---
# Vacio = solo local (sigue funcionando sin internet).
VITE_SUPABASE_URL=
# Clave publishable (sb_publishable_...). La service_role NUNCA va aqui.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Mezcla oficial YTM vía Worker propio (RDAMVM). Ej: https://tu-worker.tu-subdominio.workers.dev
VITE_YTMIX_URL=
# Spotify Client ID (público, PKCE sin secret). Redirect URI debe estar en el dashboard.
VITE_SPOTIFY_CLIENT_ID=da62420866b548cd8107525f63ac8a0e
